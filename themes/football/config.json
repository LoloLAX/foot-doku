  "diversityRulesSource": {
    "typeLigne": "(ligne, config) => { if (ligne.startsWith('Ex-')) return 'ex'; if (config.pools.CHAMPIONNATS.some(p => p.value === ligne)) return 'ligue'; return 'club'; }",
    "typeColonne": "(colonne, config) => { if (colonne.startsWith('Né en ')) return 'naissance'; if (config.pools.POSTES.some(p => p.value === colonne)) return 'poste'; return 'selection'; }"
  }
