  "rulesSource": {
    "Ex-": "(joueur, contrainte) => Array.isArray(joueur.clubs_historique) && joueur.clubs_historique.includes(contrainte.slice(3))",
    "Né en ": "(joueur, contrainte) => joueur.birth_country === contrainte.slice(6)",
    "Lettre ": "(joueur, contrainte) => _nameLetters(joueur.name).includes(contrainte.slice(7))",
    "50+ sélections": "(joueur) => (joueur.caps || 0) >= 50",
    "100+ sélections": "(joueur) => (joueur.caps || 0) >= 100",
    "10+ buts sélection": "(joueur) => (joueur.goals_selection || 0) >= 10",
    "30+ buts sélection": "(joueur) => (joueur.goals_selection || 0) >= 30",
    "Moins de 23 ans": "(joueur) => joueur.age !== null && joueur.age < 23",
    "30 ans ou plus": "(joueur) => joueur.age !== null && joueur.age >= 30"
  },
  "fieldMapping": {
    "club_current": "Club actuel",
    "league_current": "Championnat actuel",
    "nationality_selection": "Sélection nationale",
    "position": "Poste",
    "birth_country": "Pays de naissance"
  },
  "diversityRulesSource": {
    "typeLigne": "(ligne, config) => { if (ligne.startsWith('Ex-')) return 'ex'; if (config.pools.CHAMPIONNATS.some(p => p.value === ligne)) return 'ligue'; return 'club'; }",
    "typeColonne": "(colonne, config) => { if (colonne.startsWith('Né en ')) return 'naissance'; if (config.pools.POSTES.some(p => p.value === colonne)) return 'poste'; return 'selection'; }"
  },
  "rulesText": "<h2>⚽ Règles du Foot-Doku</h2><p>Vous devez compléter une grille 3×3 en trouvant des <strong>joueurs</strong> de la Coupe du Monde 2026.</p><p><strong>Règle :</strong> Chaque case doit contenir un joueur qui satisfait à la fois la contrainte de <strong>ligne</strong> (club, championnat, ancien club) et de <strong>colonne</strong> (sélection, poste, pays de naissance, statistique, etc.).</p><p>Exemple : si la ligne est « Club · Bayern Munich » et la colonne « Poste · Gardien », la case doit contenir un gardien qui joue au Bayern.</p>",
