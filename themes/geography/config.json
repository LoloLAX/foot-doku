  "rulesSource": {
    "Lettre ": "(pays, contrainte) => { const letter = (pays.capital || '')[0].toUpperCase(); return letter === contrainte.slice(7); }",
    "Commence par ": "(pays, contrainte) => pays.name_first_letter === contrainte.slice(13).toLowerCase()",
    "Finit par ": "(pays, contrainte) => pays.name_last_letter === contrainte.slice(10).toLowerCase()",
    "Contient ": "(pays, contrainte) => (pays.name_vowels || []).includes(contrainte.slice(9).toLowerCase())"
  },

  "fieldMapping": {
    "continent": "Continent",
    "subregion": "Sous-région",
